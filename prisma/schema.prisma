// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum GiftStatus {
  DISPONIVEL
  RESERVADO
  COMPRADO
}

enum PaymentMethod {
  PIX_MANUAL
  CARTAO_MERCADOPAGO
}

enum PaymentStatus {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

model GiftItem {
  id          String     @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  price       Float
  status      GiftStatus @default(DISPONIVEL)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  reservations Reservation[]
}

model Reservation {
  id            String        @id @default(cuid())
  giftItem      GiftItem      @relation(fields: [giftItemId], references: [id])
  giftItemId    String
  guestName     String
  guestContact  String?
  method        PaymentMethod
  status        PaymentStatus @default(PENDENTE)
  amount        Float
  mpPaymentId   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([giftItemId])
}

model MoneyGift {
  id            String        @id @default(cuid())
  guestName     String
  guestContact  String?
  method        PaymentMethod
  status        PaymentStatus @default(PENDENTE)
  amount        Float
  mpPaymentId   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
