// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum GiftStatus {
  DISPONIVEL
  RESERVADO
}

enum PaymentMethod {
  PIX_MANUAL
  CARTAO_MERCADOPAGO
}

enum PaymentStatus {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

// Itens específicos: sem pagamento pelo site. O convidado reserva (sem se
// identificar), compra por conta própria e entrega pessoalmente.
model GiftItem {
  id           String     @id @default(cuid())
  name         String
  description  String?
  referenceUrl String?
  imageUrl     String?
  price        Float?
  status       GiftStatus @default(DISPONIVEL)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Vales de valor e contribuições livres: pagos pelo site (Pix manual ou cartão).
model MoneyGift {
  id           String        @id @default(cuid())
  guestName    String
  guestContact String?
  method       PaymentMethod
  status       PaymentStatus @default(PENDENTE)
  amount       Float
  mpPaymentId  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}
