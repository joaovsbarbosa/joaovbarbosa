# Copie este arquivo para .env e preencha com seus valores reais.

DATABASE_URL="file:./dev.db"

# Painel admin (/admin) - defina uma senha forte antes de publicar
ADMIN_PASSWORD="troque-esta-senha"

# Dados da chave Pix exibidos no site (pagamento manual, sem taxas)
PIX_KEY="sua-chave-pix-aqui"
PIX_KEY_OWNER_NAME="Seu Nome"

# InfinitePay (opcional - pagamento por cartão)
# Sua InfiniteTag (nome de usuário no app InfinitePay), sem o "$" na frente
INFINITEPAY_HANDLE=""
